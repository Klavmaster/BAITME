{
  "name": "baitme",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "customer": "npm run start --workspace @baitme/customer",
    "restaurant": "npm run start --workspace @baitme/restaurant",
    "courier": "npm run start --workspace @baitme/courier",
    "business": "npm run dev --workspace @baitme/business-web",
    "api": "npm run start:dev --workspace @baitme/api",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:business": "npm run build --workspace @baitme/business-web"
  }
}
