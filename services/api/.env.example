PORT=8787
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Client-safe publishable key from Supabase > Connect / Settings > API Keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only secret key: NEVER place in Github, Expo or NEXT_PUBLIC fields.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY remain supported as fallbacks.
PAYMENTS_ENABLED=false
